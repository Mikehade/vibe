# ── Environment ───────────────────────────────────────────
ENV=development

# ── Database ──────────────────────────────────────────────
# Docker compose Postgres:
DATABASE_URL=postgresql+asyncpg://vibe:vibe_dev_password@localhost:5432/vibe
# Or zero-setup local SQLite (scripts/dev.sh uses this by default):
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# ── AWS / Bedrock ─────────────────────────────────────────
# Leave the keys empty to use your normal AWS profile (~/.aws) or `aws sso login`.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Used for short tasks (swap reasons, mood parsing). Falls back gracefully if unavailable.
BEDROCK_FAST_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
PLAN_TIMEOUT_SECONDS=45
MAX_AGENT_TURNS=4

# ── TMDB (v3 API key or v4 read token) ────────────────────
TMDB_API_KEY=your_tmdb_api_key
TMDB_BASE_URL=https://api.themoviedb.org/3
DEFAULT_REGION=US

# ── Offline demo mode (no keys needed) ───────────────────
FAKE_SERVICES=false

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=["*"]

LOG_LEVEL=INFO
